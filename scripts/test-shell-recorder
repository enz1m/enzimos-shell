#!/usr/bin/env python3
from pathlib import Path
import os, socket, subprocess, tempfile
root = Path(__file__).resolve().parent.parent
binary = root / '.build/shell-recorder/record-shell-frames'
assert binary.is_file(), 'Run scripts/build-shell-recorder first'
def start(pid):
    return Path(f'/proc/{pid}/stat').read_text().rsplit(') ', 1)[1].split()[19]
base = ['ENZUI-FIXTURE', '1440', '900', '2', str(os.getpid()), start(os.getpid()), 'disposable']
for index, value in [(0, 'WAYLAND-0'), (0, 'ENZREMOTE-APP'), (1, '999999'), (2, '0'), (3, '241'), (5, str(int(base[5])+1)), (6, 'no')]:
    args = base.copy(); args[index] = value
    result = subprocess.run([binary, *args], env={**os.environ, 'WAYLAND_DISPLAY': '/no-such-fixture'}, capture_output=True, timeout=3)
    assert result.returncode != 0 and not result.stdout, (index, result)
with tempfile.TemporaryDirectory(prefix='enzui-capture-test-') as temp:
    path = str(Path(temp) / 'wayland')
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path); server.listen(1); server.settimeout(3)
    sleeper = subprocess.Popen(['sleep', '10'])
    try:
        args = base.copy(); args[4] = str(sleeper.pid); args[5] = start(sleeper.pid)
        result = subprocess.run([binary, *args], env={**os.environ, 'WAYLAND_DISPLAY': path}, capture_output=True, timeout=3)
        assert result.returncode != 0 and b'wrong capture endpoint' in result.stderr and not result.stdout
        connection, _ = server.accept(); connection.settimeout(3)
        assert connection.recv(1) == b''
        connection.close()
    finally:
        sleeper.terminate(); sleeper.wait(timeout=3); server.close()
print('Recorder: bounds, explicit disposable output, stale process and socket-peer mismatch rejected before capture')
