#!/usr/bin/env lua
dofile(arg[0]:match("^(.*)/") .. "/../config/workspace-policy.lua")
local function order(state,expected)
    assert(table.concat(state.order,",")==expected,table.concat(state.order,",").." ~= "..expected)
end
local s=enzui_reconcile_workspaces(nil,1,{})
order(s,"1,2");assert(s.ghost==2)
s=enzui_reconcile_workspaces(s,1,{[1]=1});order(s,"1,2")
s=enzui_reconcile_workspaces(s,2,{[1]=1});order(s,"1,2");assert(s.ghost==2)
s=enzui_reconcile_workspaces(s,2,{[1]=1,[2]=1});order(s,"1,2,3");assert(s.ghost==3)
s=enzui_reconcile_workspaces(s,2,{[1]=1});order(s,"1,2,3")
s=enzui_reconcile_workspaces(s,1,{[1]=1});order(s,"1,3")
s=enzui_reconcile_workspaces(s,3,{[1]=1,[3]=1});order(s,"1,3,4")
local empty=enzui_reconcile_workspaces(nil,1,{})
empty=enzui_reconcile_workspaces(empty,2,{});order(empty,"1,2")
empty=enzui_reconcile_workspaces(empty,1,{});order(empty,"1,2")
empty=enzui_reconcile_workspaces(empty,2,{[2]=1});order(empty,"1,2,3")
empty=enzui_reconcile_workspaces(empty,3,{});order(empty,"1,3")
local used=enzui_reconcile_workspaces(nil,1,{[1]=1})
used=enzui_reconcile_workspaces(used,2,{});order(used,"1,2")
used=enzui_reconcile_workspaces(used,2,{[2]=1});order(used,"2,3")
local migrated=enzui_reconcile_workspaces({order={8},ghost=8,next_id=9},8,{})
order(migrated,"8,9")
local blocked=enzui_reconcile_workspaces(nil,1,{}, {[2]=true,[3]=true});order(blocked,"1,4")
blocked=enzui_reconcile_workspaces(blocked,1,{}, {[4]=true});order(blocked,"1,5")
assert(not pcall(enzui_reconcile_workspaces,nil,-1,{}))
assert(not pcall(enzui_reconcile_workspaces,nil,1,{[2]=-1}))
local monitor={name="WAYLAND-1"};local other={name="ENZREMOTE-APP"};local active=1
local function window(id,class,mon,tags)
    return {mapped=true,workspace={id=id},monitor=mon or monitor,class=class or "app",tags=tags}
end
local windows={window(1,"dev.enzui.Desktop"),window(1),window(5,nil,other),window(1,nil,nil,{"enzremote-guard-abc"}),window(1,nil,nil,{"enzui-sidebar-one"}),window(-2)}
windows[#windows+1]=window(1,"dev.enzui.PluginPanel")
local focused={}
hl={dsp={}}
function hl.get_active_workspace(output)assert(output==nil or output==monitor.name);return{id=active,monitor=monitor}end
function hl.get_workspaces()return{{id=active,monitor=monitor},{id=5,monitor=other}}end
function hl.get_windows()return windows end
function hl.dsp.focus(args)return args end
local cursor,config,warped={x=195,y=26},{no_warps=false},{}
hl.dsp.cursor={move=function(args)args.cursor=true;return args end}
function hl.get_cursor_pos()return{x=cursor.x,y=cursor.y}end
function hl.get_config(key)assert(key=="cursor.no_warps");return config.no_warps end
function hl.config(values)config.no_warps=values.cursor.no_warps end
local focused_window
function hl.dispatch(args)
    if args.cursor then cursor={x=args.x,y=args.y};table.insert(warped,args);return{ok=true} end
    if args.workspace then table.insert(focused,args.workspace);active=args.workspace end
    -- Focusing a window warps the cursor onto it unless warps are off.
    if args.window then focused_window=args.window;if not config.no_warps then cursor={x=720,y=475} end end
    return{ok=true}
end
local snapshot=enzui_workspace_snapshot("WAYLAND-1")
assert(snapshot=='{"active":1,"desktops":[{"id":1,"windows":1,"placeholder":false},{"id":2,"windows":0,"placeholder":true}]}',snapshot)
enzui_workspace_step("WAYLAND-1",1);assert(active==2)
enzui_workspace_step("WAYLAND-1",1);assert(#focused==1)
windows[#windows+1]=window(2)
enzui_workspace_step("WAYLAND-1",1);assert(active==3)
enzui_workspace_step("WAYLAND-1",-1);assert(active==2)
assert(not pcall(enzui_workspace_focus,"WAYLAND-1",5))
assert(not pcall(enzui_workspace_snapshot,"ENZREMOTE-APP"))
assert(not pcall(enzui_workspace_step,"WAYLAND-1",2))
local keys,removed={},0
function hl.unbind(key)removed=removed+1 end
function hl.bind(key,callback)keys[key]=callback end
windows={window(2)};active=2
assert(enzui_workspace_id_at("WAYLAND-1",1)==2)
enzui_install_workspace_keys();keys["SUPER + 2"]();assert(active==3)
local before=#focused;keys["SUPER + 9"]();assert(#focused==before)
enzui_install_workspace_keys();assert(removed==9)
local older,recent=window(2),window(2)
older.focus_history_id=8;recent.focus_history_id=2
local panel=window(2,"dev.enzui.Desktop");panel.focus_history_id=0
local parked=window(2,nil,nil,{"enzui-sidebar-one"});parked.focus_history_id=1
local plugin=window(2,"dev.enzui.PluginPanel");plugin.focus_history_id=0
windows={older,recent,panel,parked,plugin}
enzui_workspace_focus("WAYLAND-1",2);assert(focused_window==recent)
-- The switch neither warps the cursor nor leaves the pointer with the app.
assert(cursor.x==195 and cursor.y==26 and not config.no_warps)
assert(warped[#warped].x==195 and warped[#warped].y==26)
recent.hidden=true
enzui_workspace_focus("WAYLAND-1",2);assert(focused_window==older)
print("Workspace policy: initial/trailing empty slots, occupancy growth, inactive-empty removal, stable IDs, bounds and scoped navigation passed.")
