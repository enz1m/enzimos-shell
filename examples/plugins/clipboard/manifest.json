{
  "format": 1,
  "id": "clipboard",
  "name": "Clipboard history",
  "version": "1.3.5",
  "description": "Volatile text and PNG history for this managed Wayland desktop, with retention, size limits and pause controls.",
  "permissions": ["shell.bar", "shell.panels", "clipboard.read", "clipboard.write"],
  "elements": [{"id": "history", "section": "end", "before": "builtin.controls"}],
  "settings": [
    {"key": "collect", "label": "Collect copied content on startup", "kind": "toggle", "default": true},
    {"key": "retention_minutes", "label": "Keep history for minutes", "kind": "integer", "default": 60, "min": 1, "max": 1440},
    {"key": "max_mb", "label": "Maximum history MiB", "kind": "integer", "default": 8, "min": 1, "max": 16}
  ]
}
