hl={dsp={window={},cursor={}},plugin={enzui_pointer_events={version=function()return 1 end}}}
local no_warps,follow_mouse=false,1
function hl.get_config(key)if key=="cursor.no_warps"then return no_warps elseif key=="input.follow_mouse"then return follow_mouse end end
function hl.config(value)
    if value.cursor then no_warps=value.cursor.no_warps end
    if value.input then follow_mouse=value.input.follow_mouse end
end
function hl.dsp.cursor.move(args)args.action_name="cursor";return args end
local subscriptions={};local raised=0;local focused=0;local resize_calls=0;local pin_calls=0
for _,name in ipairs({"pin","float","move","resize","tag","alter_zorder"})do hl.dsp.window[name]=function(args)args.action_name=name;return args end end
function hl.dsp.focus(args)args.action_name="focus";return args end
function hl.dsp.event(text)return{action_name="event"}end
local rail_rule,rail_updates=nil,0
local backing_rule
function hl.window_rule(rule)
    if rule.name=="sidebar-rail-input" then
        assert(rule.match.class=="^dev[.]enzui[.]Sidebar$" and rule.match.tag=="enzui-sidebar-chrome-888")
        rail_rule=rule;rail_updates=rail_updates+1
    elseif rule.name=="sidebar-fullscreen-backing" then
        assert(rule.no_focus and rule.opacity=="0 override 0 override")
        backing_rule=rule
    else
        assert(rule.name=="sidebar-app-chrome" and rule.border_size==0 and rule.no_anim==true and rule.no_xdg_drags==true and rule.decorate==false and rule.match.tag=="enzui-sidebar-app")
    end
end
function hl.get_monitors()return{output}end
function hl.get_windows()return windows end
function hl.get_workspaces()return{workspace}end
function hl.get_active_workspace(name)assert(name=="TEST");return workspace end
function hl.get_cursor_pos()return point end
local keyboard_reveal
function hl.bind(key,callback,options)
    if key=="SUPER + SHIFT + B" then assert(options==nil);keyboard_reveal=callback;return{} end
    assert(options.non_consuming and options.ignore_mods);bindings[#bindings+1]={callback=callback,options=options};return{}
end
function hl.on(event,callback)assert(type(event)=="string" and type(callback)=="function");subscriptions[event]=callback;return{remove=function()end}end
function hl.timer(callback,options)
    local timer={timeout=options.timeout,callback=callback}
    function timer:set_timeout(timeout)self.timeout=timeout end
    return timer
end
function hl.dispatch(args)
    local w=args.window
    if args.action_name=="event" then events=events+1
    elseif args.action_name=="alter_zorder" then
        assert(w.pid==888)
        if w.class=="dev.enzui.Sidebar" then assert(args.mode=="top");raised=raised+1
        else assert(w.class=="dev.enzui.SidebarPane" and args.mode=="bottom") end
    elseif args.action_name=="cursor" then assert(follow_mouse==3);point={x=args.x,y=args.y}
    elseif args.action_name=="focus" then
        focused=focused+1
        if not no_warps then point={x=w.at.x+w.size.x/2,y=w.at.y+w.size.y/2} end
    elseif args.action_name=="pin" then pin_calls=pin_calls+1;w.pinned=args.action=="on"
    elseif args.action_name=="float" then w.floating=args.action=="on"
    elseif args.action_name=="resize" then
        if fail_resize and w==app then return {ok=false} end
        resize_calls=resize_calls+1;w.size={x=args.x,y=args.y}
    elseif args.action_name=="move" then
        if args.workspace then
            if type(args.workspace)=="string" then if fail_park then return{ok=false}end;w.workspace={name="special:enzui-miniapps",monitor=output}
            else w.workspace={id=args.workspace,monitor=output} end
        else w.at={x=args.x,y=args.y} end
    elseif args.action_name=="tag" then
        if args.tag:sub(1,1)=="+" then w.tags[#w.tags+1]=args.tag:sub(2)
        else for i=#w.tags,1,-1 do if w.tags[i]==args.tag:sub(2) then table.remove(w.tags,i)end end end
    end
    return{ok=true}
end
