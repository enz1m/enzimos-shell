#!/usr/bin/env python3
"""Build receipts: which source produced which bytes.

  scripts/build-receipt source DIR          the tracked source state of checkout DIR
  scripts/build-receipt write RECEIPT SOURCE_JSON FILE...
                                            a receipt binding that state to FILE hashes

The source state is taken before building (HEAD, whether tracked files differ
from it, and a hash of that difference), so a receipt names the tree that was
compiled, not whatever the checkout holds later. scripts/export-desktop reads
the receipts and refuses bytes they do not describe."""
import hashlib
import json
from pathlib import Path
import subprocess
import sys


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as source:
        for block in iter(lambda: source.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def source_state(directory):
    git = ["git", "-C", str(directory)]
    revision = subprocess.run([*git, "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
    diff = subprocess.run([*git, "diff", "HEAD", "--binary", "--no-ext-diff"], capture_output=True, check=True).stdout
    return {"revision": revision, "dirty": bool(diff), "diff_sha256": hashlib.sha256(diff).hexdigest() if diff else None}


def main():
    if sys.argv[1:2] == ["source"] and len(sys.argv) == 3:
        print(json.dumps(source_state(Path(sys.argv[2]))))
    elif sys.argv[1:2] == ["write"] and len(sys.argv) >= 5:
        receipt, source, files = Path(sys.argv[2]), json.loads(sys.argv[3]), sys.argv[4:]
        document = {"schema": 1, **source, "files": {Path(f).name: sha256_file(f) for f in files}}
        temporary = receipt.with_name(receipt.name + ".new")
        temporary.write_text(json.dumps(document, indent=2) + "\n")
        temporary.replace(receipt)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
