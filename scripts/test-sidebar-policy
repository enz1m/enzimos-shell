local prepared_inset
local prepare_base=native.prepare
native.prepare=function(addr,pid,x,y,w,h,right,inset)
    prepared_inset=inset
    return prepare_base(addr,pid,x,y,w,h,right)
end
native.repin=function(addr,pid,x,y,w,h,right,inset)
    assert(addr==address and pid==888 and phase=="detached" and inset==prepared_inset)
    assert(w==app.size.x and h==app.size.y)
    phase="opening";repins=repins+1;return true
end
local function pane_bounds()
    local box={}
    for v in enzui_sidebar_snapshot():match('"pane":(%b[])'):gmatch("%-?%d+")do box[#box+1]=tonumber(v)end
    assert(#box==4);return table.unpack(box)
end
floating.islands.side_gap=12;floating.islands.edge_gap=10;floating.islands.gap=8
for _,canvas in ipairs({{1440,900},{800,480},{400,640}})do
    output.width=canvas[1];output.height=canvas[2]
    for _,side in ipairs({"left","right"})do
        for _,bar in ipairs({"top","bottom"})do
            for radius=0,32 do
                floating.radius=radius;floating.islands.radius=radius
                assert(enzui_sidebar_configure("TEST",side,bar,888,floating).ok)
                assert(enzui_sidebar_toggle(retained[1].id).ok)
                local px,py,pw,ph=pane_bounds()
                local inset=prepared_inset
                assert(inset==math.max(6,math.ceil(radius*(1-math.sqrt(0.5)))))
                assert(inset>=6 and inset<=10)
                assert(app.at.x==px+inset and app.at.y==py+inset)
                assert(app.size.x==pw-2*inset and app.size.y==ph-2*inset)
                assert(px>=output.x+12 and px+pw<=output.x+output.width-12)
                local top=bar=="top" and 50 or 10
                local bottom=output.height-(bar=="bottom" and 50 or 10)
                assert(py>=output.y+top and py+ph<=output.y+bottom)
                local r=math.min(radius,pw/2,ph/2)
                for _,x in ipairs({app.at.x,app.at.x+app.size.x})do
                    for _,y in ipairs({app.at.y,app.at.y+app.size.y})do
                        local dx=x-math.max(px+r,math.min(x,px+pw-r))
                        local dy=y-math.max(py+r,math.min(y,py+ph-r))
                        assert(dx*dx+dy*dy<=r*r)
                    end
                end
                if radius==16 and canvas[1]==800 and side=="right"and bar=="bottom"then
                    assert(px==368 and py==10 and pw==372 and ph==420 and inset==6)
                end
                if radius==32 and canvas[1]==800 and side=="right"and bar=="bottom"then
                    assert(px==360 and py==10 and pw==380 and ph==420 and inset==10)
                end
                phase="open";enzui_sidebar_tick()
                if radius==32 then
                    point={x=app.at.x+20,y=app.at.y+20};enzui_sidebar_press();phase="dragging"
                    enzui_sidebar_cancel_drag();assert(enzui_sidebar.pending.repin==retained[1].id)
                    phase="detached";local before_repins=repins;enzui_sidebar_tick();assert(repins==before_repins+1)
                    phase="open";enzui_sidebar_tick()
                end
                assert(enzui_sidebar_hide().ok);phase="closed";enzui_sidebar_tick()
                assert(phase=="idle" and retained[1].original==saved_original)
            end
        end
    end
end
