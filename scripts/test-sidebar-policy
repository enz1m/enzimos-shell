local phase="idle";local address=nil;local commands={};local configured=0
local native={version=function()return 1 end}
function native.supports(addr,pid)assert(pid==888);return addr==app.address and app.native_supported~=false end
function native.configure(pid,name)assert(pid==888 and name=="TEST");configured=configured+1;return true end
function native.prepare(addr,pid,x,y,w,h,right)
    assert(phase=="idle" and pid==888 and type(right)=="boolean")
    assert(app.workspace.id==nil and w>0 and h>0)
    address=addr;phase="opening";commands[#commands+1]="prepare";return true
end
local owner_alive=true
function native.status(addr)
    if not owner_alive and (phase=="open" or phase=="opening") then phase="failed" end
    return addr==address and phase or "idle"
end
function native.show(addr)assert(addr==address);phase="opening";commands[#commands+1]="show";return true end
function native.hide(addr)assert(addr==address);phase="closing";commands[#commands+1]="hide";return true end
function native.restore(addr,pid,x,y,w,h)
    assert(pid==888 and (phase=="closed" or phase=="failed" or phase=="idle" or phase=="detached" or phase=="dialog"))
    address=addr;phase="restoring";commands[#commands+1]="restore";return true
end
function native.finish(addr)
    assert((addr=="" and not app.mapped) or (addr==address and (phase=="closed" or phase=="restored" or phase=="foreign")))
    phase="idle";address=nil;commands[#commands+1]="finish";return true
end
