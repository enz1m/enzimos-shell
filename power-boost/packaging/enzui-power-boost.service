[Unit]
Description=enzUI animation power boost

[Service]
Type=dbus
BusName=dev.enzui.PowerBoost1
ExecStart=/usr/lib/enzui/bin/enzui-power-boost
Restart=on-failure
RestartSec=1
# The crash marker outlives the process so a restarted helper can end its boost.
RuntimeDirectory=enzui-power-boost
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
# Root needs no capability to write sysfs; only the cpufreq policies are writable.
ProtectKernelTunables=yes
ReadWritePaths=/sys/devices/system/cpu/cpufreq
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
