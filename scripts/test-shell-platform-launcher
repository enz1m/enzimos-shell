        self.assertEqual(values["ENZUI_PORTAL_INPUT_EXES"], remote)
        self.assertNotIn(remote, values["ENZUI_PORTAL_HELPER_EXES"])
        self.assertEqual(values["ENZUI_CONTROL_EXES"].split(":"), [*(str((self.root / name).resolve()) for name in ("enzui-settings", "enzui-welcome")),
                                                                   "/usr/libexec/enzimos-phone-link/enzremote-signaling"])
        self.assertEqual(values["ENZUI_IME_EXES"], "/usr/bin/fcitx5")
        self.assertEqual(values["ENZUI_TEXT_COMMIT_EXES"], "/usr/bin/enzimos-dictation")
        self.assertEqual(platform.privileged_clients(self.root, "/usr/bin/env")["ENZUI_DEV_PRIVILEGED_EXES"], "/usr/bin/env")
        for bad in ["env", "/nonexistent/tool", "/usr/bin/env:relative", "/usr/bin/e nv"]:
            with self.assertRaises(argparse.ArgumentTypeError):
                platform.dev_tool_list(bad)
        self.assertEqual(platform.dev_tool_list("/usr/bin/env"), str(Path("/usr/bin/env").resolve()))

    def test_live_rejects_zombies_and_reused_process_ids(self):
        for state, ticks, expected in [("S", 7, True), ("Z", 7, False), ("X", 7, False), ("S", 8, False)]:
