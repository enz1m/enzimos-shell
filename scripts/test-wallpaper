#!/usr/bin/env python3
import errno
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import signal
import struct
import subprocess
import tempfile
import threading
import time
import unittest
from unittest import mock
import zlib
from PIL import Image

ROOT = Path(__file__).resolve().parent.parent


def module(name):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(ROOT / "scripts" / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    value = importlib.util.module_from_spec(spec)
    loader.exec_module(value)
    return value


importer, worker = module("import-wallpaper"), module("run-wallpaper")


class WallpaperTests(unittest.TestCase):
    def setUp(self):
        self.directory = tempfile.TemporaryDirectory(prefix="enzui-wallpaper-")
        self.root = Path(self.directory.name)
        self.cache = self.root / "wallpapers"

    def tearDown(self):
        self.directory.cleanup()

    def picture(self, name="source.png", format="PNG", **options):
        source = self.root / name
        Image.new("RGB", (22, 11), (30, 90, 150)).save(source, format=format, **options)
        return source

    def run_import(self, source):
        return importer.import_image({"source": str(source), "cache": str(self.cache)})

    def test_decoded_local_images_are_copied_into_private_pngs(self):
        for format, suffix in [("PNG", "png"), ("JPEG", "jpg"), ("WEBP", "webp")]:
            with self.subTest(format=format):
                source = self.picture("source." + suffix, format)
                result = self.run_import(source)
                target = Path(result["path"])
                self.assertEqual(target.parent, self.cache)
                self.assertEqual(target.name, hashlib.sha256(target.read_bytes()).hexdigest() + ".png")
                self.assertEqual(target.stat().st_mode & 0o777, 0o600)
                source.unlink()
                with Image.open(target) as image:
                    self.assertEqual(image.format, "PNG")
                    self.assertEqual(image.size, (22, 11))
                    self.assertEqual(image.mode, "RGBA")

    def test_renderer_receives_a_private_content_bound_snapshot(self):
        result = self.run_import(self.picture())
        path = Path(result["path"])
        data = path.read_bytes()
        snapshot = worker.image_snapshot(path, self.root / "settings.json", self.root / "runtime")
        path.write_bytes(b"changed")
        self.assertEqual(snapshot.read_bytes(), data)
        self.assertEqual(snapshot.stat().st_mode & 0o777, 0o400)
        with self.assertRaises(PermissionError):
            snapshot.write_bytes(b"x")
        with self.assertRaises(ValueError):
            worker.image_snapshot(path, self.root / "settings.json", self.root / "runtime")
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        image = GdkPixbuf.Pixbuf.new_from_file(str(snapshot))
        self.assertEqual((image.get_width(), image.get_height()), (22, 11))

    def test_renderer_rejects_unimported_paths(self):
        with self.assertRaises(ValueError):
            worker.image_snapshot(self.picture(), self.root / "settings.json", self.root / "runtime")

    def test_decoder_failure_is_not_a_successful_color_fallback(self):
        self.assertTrue(worker.renderer_failed(b"[ERROR] Failed to load image"))
        self.assertTrue(worker.renderer_failed(b"x" * 16385))
        self.assertFalse(worker.renderer_failed(b"[DEBUG] Found config for output"))

    def test_exif_orientation_is_applied_before_metadata_is_removed(self):
        exif = Image.Exif()
        exif[274] = 6
        result = self.run_import(self.picture("rotated.jpg", "JPEG", exif=exif))
        with Image.open(result["path"]) as image:
            self.assertEqual(image.size, (11, 22))
            self.assertFalse(image.getexif())

    def test_links_fifos_and_nonimages_are_rejected(self):
        source = self.picture()
        link = self.root / "linked.png"
        link.symlink_to(source)
        fifo = self.root / "fifo.png"
        os.mkfifo(fifo)
        text = self.root / "text.png"
        text.write_text("not an image")
        for item in [link, fifo, text]:
            with self.subTest(path=item.name), self.assertRaises((OSError, ValueError)):
                self.run_import(item)

    def test_input_size_is_checked_before_reading(self):
        source = self.root / "large.png"
        with source.open("wb") as stream:
            stream.truncate(importer.MAX_BYTES + 1)
        with self.assertRaises(ValueError):
            self.run_import(source)

    def test_decompression_dimensions_are_bounded(self):
        def chunk(kind, data):
            return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
        source = self.root / "dimensions.png"
        source.write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 8192, 8192, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(b"")) + chunk(b"IEND", b""))
        with self.assertRaises((Image.DecompressionBombError, Image.DecompressionBombWarning, ValueError)):
            self.run_import(source)

    def test_typical_config_parent_keeps_imported_media_private(self):
        source = self.picture()
        original_cache = self.cache
        self.cache = self.root / "fresh-config" / "enzui-shell" / "wallpapers"
        fresh = self.run_import(source)
        self.assertEqual(self.cache.parent.stat().st_mode & 0o777, 0o700)
        self.assertTrue(Path(fresh["path"]).is_file())
        self.cache = original_cache
        self.root.chmod(0o755)
        result = self.run_import(source)
        self.assertEqual(self.cache.stat().st_mode & 0o777, 0o700)
        self.assertEqual(Path(result["path"]).stat().st_mode & 0o777, 0o600)
        self.root.chmod(0o777)
        with self.assertRaises(ValueError):
            self.run_import(source)
        self.root.chmod(0o700)

    def test_storage_must_be_private(self):
        self.cache.mkdir(mode=0o755)
        self.cache.chmod(0o755)
        with self.assertRaises(ValueError):
            self.run_import(self.picture())

    def test_preferences_reject_invalid_modes_and_shapes(self):
        self.assertEqual(worker.preferences({})["revision"], 0)
        for invalid in [{"kind": "video"}, {"kind": "image"}, {"color": "red"}, {"image": "relative.png"}, {"revision": True}, {"revision": -1}, {"revision": 2**64}, {"fit": "execute"}]:
            with self.subTest(value=invalid), self.assertRaises(ValueError):
                worker.preferences(invalid)

    def test_renderer_arguments_are_literal_and_transition_only_when_replacing(self):
        value = worker.preferences({"kind": "image", "image": "/owned/image with ' quotes.png", "fit": "fit"})
        binary = ROOT / "target/debug/enzui-wallpaper"
        args = worker.arguments(value, ROOT / "assets/wallpaper.png", binary, Path("/private/snapshot.png"), True)
        self.assertEqual(args, [str(binary), "172b40", "fit", "/private/snapshot.png", "fade"])
        self.assertEqual(worker.arguments(worker.preferences({"kind": "color"}), "default", binary)[3:], ["-", "immediate"])
        self.assertEqual(worker.arguments(worker.preferences({}), "default", binary)[3:], ["default", "immediate"])

    def test_atomically_replaced_settings_start_a_new_renderer_until_the_compositor_exits(self):
        runtime, profile, binaries = self.root / "runtime", self.root / "profile", self.root / "bin"
        for directory in (runtime, profile, binaries):
            directory.mkdir(mode=0o700)
        started = self.root / "started"
        renderer = binaries / "enzui-wallpaper"
        renderer.write_text(f"#!/bin/sh\necho \"$$ $1\" >> {started}\necho ready\nexec sleep 30\n")
        renderer.chmod(0o700)
        settings = profile / "settings.json"

        def save(color):
            descriptor, name = tempfile.mkstemp(dir=profile)
            with os.fdopen(descriptor, "w") as out:
                json.dump({"wallpaper": {"kind": "color", "color": "#" + color}}, out)
            os.replace(name, settings)

        def renderers():
            return [line.split() for line in started.read_text().splitlines()] if started.exists() else []

        def layers(*_):
            surfaces = [{"pid": int(pid), "w": 1, "h": 1} for pid, _ in renderers()]
            return json.dumps({"OWNED-1": {"levels": {"0": surfaces}}})

        save("112233")
        worker.platform.publish(runtime / "launch.json", {"settings": str(settings), "shell_bin_dir": str(binaries)})
        compositor = subprocess.Popen(["sleep", "30"])
        self.addCleanup(lambda: (compositor.kill(), compositor.wait()))
        identity = {"pid": compositor.pid, "start": worker.platform.start_ticks(compositor.pid), "display": "wayland-owned", "instance": "owned"}
        replaced = []
        publish = worker.platform.publish
        failed_status = threading.Event()

        def publish_status(path, value):
            if path.name == "wallpaper-status.json" and not failed_status.is_set():
                failed_status.set()
                raise OSError(errno.ENOSPC, "full")
            publish(path, value)

        def replace_then_end():
            deadline = time.monotonic() + 5
            while len(renderers()) < 1 and time.monotonic() < deadline:
                time.sleep(.02)
            time.sleep(.3)
            replaced.append(time.monotonic())
            save("445566")
            while len(renderers()) < 2 and time.monotonic() < deadline + 5:
                time.sleep(.02)
            replaced.append(time.monotonic())
            time.sleep(.3)
            replaced.append(time.monotonic())
            compositor.kill()

        driver = threading.Thread(target=replace_then_end)
        handlers = signal.getsignal(signal.SIGTERM), signal.getsignal(signal.SIGINT)
        try:
            with mock.patch.dict(os.environ, {"ENZUI_HYPR_RUNROOT": str(runtime), "WAYLAND_DISPLAY": "wayland-owned"}), \
                    mock.patch.object(worker.platform, "compositor", return_value=identity), \
                    mock.patch.object(worker.platform, "desktop_output", return_value="OWNED-1"), \
                    mock.patch.object(worker.platform, "control", side_effect=layers), \
                    mock.patch.object(worker.platform, "publish", side_effect=publish_status):
                driver.start()
                worker.run()
                ended = time.monotonic()
        finally:
            driver.join()
            signal.set_wakeup_fd(-1)
            signal.signal(signal.SIGTERM, handlers[0])
            signal.signal(signal.SIGINT, handlers[1])
        self.assertEqual([color for _, color in renderers()], ["112233", "445566"])
        self.assertTrue(failed_status.is_set())
        self.assertLess(replaced[1] - replaced[0], 1)
        self.assertLess(ended - replaced[2], 1)
        for pid, _ in renderers():
            self.assertFalse(Path(f"/proc/{pid}").exists())
        status = json.loads((profile / "wallpaper-status.json").read_text())
        self.assertEqual((status["request"]["color"], status["error"]), ("#445566", None))

    def test_primary_change_relocates_live_wallpaper_and_keeps_the_shared_backdrop(self):
        runtime, profile, binaries, scenes = (self.root / name for name in ("runtime", "profile", "bin", "scenes"))
        for directory in (runtime, profile, binaries, scenes / "scene"):
            directory.mkdir(mode=0o700, parents=True)
        (scenes / "scene/scene.toml").touch()
        started = self.root / "started"
        for name, output in (("enzui-wallpaper", "backdrop"), ("enzwall", "$4")):
            renderer = binaries / name
            renderer.write_text(f'#!/bin/sh\nprintf "%s %s\\n" "$$" "{output}" >> "{started}"\necho ready\nexec sleep 30\n')
            renderer.chmod(0o700)
        settings = profile / "settings.json"
        worker.platform.publish(settings, {"wallpaper": {"kind": "live", "scene": "scene"}})
        worker.platform.publish(runtime / "launch.json", {"runtime": str(runtime), "settings": str(settings),
                                                         "shell_bin_dir": str(binaries), "xdg_runtime": str(runtime)})
        worker.platform.publish(runtime / "output.json", {"output": "LEFT"})
        compositor = subprocess.Popen(["sleep", "30"])
        self.addCleanup(lambda: (compositor.kill(), compositor.wait()))
        identity = {"pid": compositor.pid, "start": worker.platform.start_ticks(compositor.pid), "display": "wayland-owned", "instance": "owned"}

        def renderers():
            return [line.split() for line in started.read_text().splitlines()] if started.exists() else []

        def layers(*_):
            return json.dumps({
                output: {"levels": {"0": [{"pid": int(pid), "w": 1, "h": 1} for pid, target in renderers()
                                          if target in (output, "backdrop")]}}
                for output in ("LEFT", "RIGHT")
            })

        def relocate():
            status = profile / "wallpaper-status.json"
            for count in (2, 3):
                deadline = time.monotonic() + 5
                while time.monotonic() < deadline:
                    children = renderers()
                    if len(children) == count and status.exists() and json.loads(status.read_text())["pid"] == int(children[-1][0]):
                        break
                    time.sleep(.02)
                if count == 2:
                    worker.platform.publish(runtime / "output.json", {"output": "RIGHT"})
            compositor.kill()

        driver = threading.Thread(target=relocate)
        handlers = signal.getsignal(signal.SIGTERM), signal.getsignal(signal.SIGINT)
        try:
            with mock.patch.dict(os.environ, {"ENZUI_HYPR_RUNROOT": str(runtime), "WAYLAND_DISPLAY": "wayland-owned"}), \
                    mock.patch.object(worker, "LIVE_SCENES", scenes), \
                    mock.patch.object(worker.platform, "compositor", return_value=identity), \
                    mock.patch.object(worker.platform, "control", side_effect=layers):
                driver.start()
                worker.run()
        finally:
            driver.join()
            signal.set_wakeup_fd(-1)
            signal.signal(signal.SIGTERM, handlers[0])
            signal.signal(signal.SIGINT, handlers[1])
        self.assertEqual([output for _, output in renderers()], ["backdrop", "LEFT", "RIGHT"])
        for pid, _ in renderers():
            self.assertFalse(Path(f"/proc/{pid}").exists())


if __name__ == "__main__":
    unittest.main()
