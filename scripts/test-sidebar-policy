phase="restored";enzui_sidebar_tick();assert(#enzui_sidebar.entries==1)
enzui_desktop.tiling=false;enzui_sidebar_snapshot();assert(mode==false)
print("Tiled pinning: native move/release admission survives size changes; feedback identity and drop-position restoration passed.")

-- A vanished output must not raise from the pointer callbacks. The snapshot
-- request still reports the missing output to its caller.
native.tiling_mode=function()return false end
native.rail=function()return false end
output.enabled=false
local pressed,released=pcall(enzui_sidebar_press),pcall(enzui_sidebar_release)
assert(pressed and released,"pointer callbacks raised after the output went away")
assert(pcall(enzui_sidebar_tick),"tick raised after the output went away")
local ok,err=pcall(enzui_sidebar_snapshot)
assert(not ok and tostring(err):match("Sidebar output unavailable"),"snapshot should report the missing output")
output.enabled=true
native.tiling_mode=function()return true end
native.rail=function(_,visible)rail_source.visible=visible;return true end
local ok2,err2=pcall(enzui_sidebar_snapshot)
assert(ok2,"snapshot raised after the output returned: "..tostring(err2))
print("Lost output: pointer callbacks stay quiet; the snapshot still reports it.")
assert(enzui_sidebar_configure("TEST","left","top",888,floating,nil,nil,"shared",false).ok)
local disabled=enzui_sidebar_snapshot()
assert(disabled:find('"enabled":false',1,true) and not rail_source.visible)
assert(output.reserved.left==0 and not area.enabled)
assert(not enzui_sidebar_pin_window(other).ok)
assert(not enzui_sidebar_toggle(enzui_sidebar.entries[1].id).ok)
assert(enzui_sidebar_configure("TEST","left","top",888,floating,nil,nil,"shared",true).ok)
assert(enzui_sidebar_snapshot():find('"enabled":true',1,true))
print("Sidebar power: off disables rail/input/drop/reservations without destroying entries; on restores controls.")
