    def test_private_metadata_rejects_links_public_modes_and_special_files(self):
        regular = self.root / "regular"
        regular.write_bytes(b"fixture")
        regular.chmod(0o600)
        link = self.root / "link"
        link.symlink_to(regular)
        with self.assertRaises(OSError):
            platform.read_private(link)
        os.link(regular, self.root / "hardlink")
        with self.assertRaises(RuntimeError):
            platform.read_private(regular)
        (self.root / "hardlink").unlink()
        regular.chmod(0o644)
        with self.assertRaises(RuntimeError):
            platform.read_private(regular)
        fifo = self.root / "fifo"
        os.mkfifo(fifo, 0o600)
        with self.assertRaises(RuntimeError):
            platform.read_private(fifo)
        directory = self.root / "public"
        directory.mkdir(mode=0o755)
        directory.chmod(0o755)
        with self.assertRaises(RuntimeError):
            platform.private_directory(directory)
        self.assertEqual(regular.read_bytes(), b"fixture")

    def ended_desktop(self, pid=4242, lock=True, report=False):
        runtime = self.root / "runtime"
        instance = self.root / "xdg/hypr/sig_1_2"
        cache = self.root / "cache"
        for directory in (runtime, instance, cache):
            directory.mkdir(parents=True, mode=0o700, exist_ok=True)
        platform.publish(runtime / "hyprland.pid", pid)
        (runtime / "instance").write_text("sig_1_2\n")
        (runtime / "hyprland.log").write_bytes(b"early\n" + b"x" * 70000 + b"\nHyprland has crashed :(\n")
        (runtime / "shell.log").write_text("shell said goodbye\n")
        (runtime / "startup.log").write_text("starting\n")
        (runtime / "startup.log").chmod(0o644)
        (instance / "hyprland.log").write_text("internal tail\n")
        if lock:
            (instance / "hyprland.lock").write_text(f"{pid}\nwayland-1\n")
        if report:
            (cache / f"hyprlandCrashReport{pid}.txt").write_text("Hyprland received signal 6(ABRT)\nBacktrace:\n")
        return runtime, self.root / "xdg", str(cache)

    def test_orderly_logout_keeps_no_failure_diagnostics(self):
        runtime, xdg, cache = self.ended_desktop(lock=False)
        self.assertIsNone(platform.desktop_failure(runtime, xdg, cache, "compositor-exited", True))
        # A lock left by an earlier compositor does not name this one.
        (xdg / "hypr/sig_1_2/hyprland.lock").write_text("99\nwayland-1\n")
        self.assertIsNone(platform.desktop_failure(runtime, xdg, cache, "compositor-exited", True))

    def test_abnormal_endings_are_failures(self):
        runtime, xdg, cache = self.ended_desktop(report=True)
        self.assertEqual(platform.desktop_failure(runtime, xdg, cache, "compositor-exited", True), "compositor-crashed")
        (Path(cache) / "hyprlandCrashReport4242.txt").unlink()
        self.assertEqual(platform.desktop_failure(runtime, xdg, cache, "compositor-exited", True), "compositor-ended-abnormally")
        # A failed startup stops the unit, so its compositor's leftover lock is expected.
        self.assertEqual(platform.desktop_failure(runtime, xdg, cache, None, False), "startup-failed")
        (xdg / "hypr/sig_1_2/hyprland.lock").unlink()
        self.assertEqual(platform.desktop_failure(runtime, xdg, cache, "shell-keeps-exiting", True), "shell-keeps-exiting")
        platform.record_shell_exit(runtime, mock.Mock(pid=42, returncode=-signal.SIGABRT))
        self.assertEqual(platform.desktop_failure(runtime, xdg, cache, "compositor-exited", True), "shell-exited-abnormally")

    def test_failure_diagnostics_are_bounded_private_and_pruned(self):
        runtime, xdg, cache = self.ended_desktop(report=True)
        parent = self.root / "state/desktop-failures"
        bundle = platform.retain_failure_diagnostics(runtime, xdg, cache, parent, "compositor-crashed", now=1795408477)
        self.assertTrue(bundle.name.startswith("20261123T043437Z-"))
        manifest = json.loads((bundle / "manifest.json").read_text())
        self.assertEqual((manifest["failure"], manifest["compositor_pid"]), ("compositor-crashed", 4242))
        self.assertEqual(set(manifest["files"]), {"startup.log", "compositor.log", "shell.log", "compositor-internal.log", "crash-report.txt"})
        compositor = (bundle / "compositor.log").read_bytes()
        self.assertEqual(len(compositor), platform.FAILURE_EXCERPT_BYTES)
        self.assertTrue(compositor.endswith(b"Hyprland has crashed :(\n"))
        self.assertTrue(manifest["files"]["compositor.log"]["truncated"])
        self.assertTrue((bundle / "crash-report.txt").read_text().startswith("Hyprland received signal 6"))
        for path in (parent, bundle, *bundle.iterdir()):
            self.assertEqual(path.stat().st_mode & 0o077, 0, path)
        for _ in range(platform.FAILURE_BUNDLES + 2):
            platform.retain_failure_diagnostics(runtime, xdg, cache, parent, "compositor-crashed")
        self.assertEqual(len(list(parent.iterdir())), platform.FAILURE_BUNDLES)

    def test_failed_diagnostics_keep_the_previous_log_and_hide_incomplete_bundles(self):
        runtime, xdg, cache = self.ended_desktop()
        state = self.root / "state"
        state.mkdir()
        log = state / "last-desktop.log"
        log.write_text("preceding startup log")
        with mock.patch.object(platform.os, "fsync", side_effect=OSError(errno.ENOSPC, "full")):
            platform.save_desktop_diagnostics(runtime, xdg, cache, state, "compositor-exited", True)
        self.assertEqual(log.read_text(), "preceding startup log")
        self.assertEqual(list((state / "desktop-failures").iterdir()), [])
        self.assertCountEqual(list(state.iterdir()), [log, state / "desktop-failures"])

    def test_retirement_removes_only_the_dead_owned_compositor_instance(self):
        child, ticks = self.process()
        runtime, xdg, _ = self.ended_desktop(pid=child.pid)
        platform.publish(runtime / "hyprland.pid.start", ticks)
        instance = xdg / "hypr/sig_1_2"
        instance.parent.chmod(0o700)
        sibling = instance.with_name("another-session")
        sibling.mkdir()
        platform.retire_compositor_instance(runtime, xdg)
        self.assertTrue(instance.is_dir())
        child.kill()
        child.wait()
        platform.retire_compositor_instance(runtime, xdg)
        self.assertFalse(instance.exists())
        self.assertTrue(sibling.is_dir())

    def test_failure_diagnostics_skip_linked_or_missing_logs(self):
        runtime, xdg, cache = self.ended_desktop()
        secret = self.root / "secret.txt"
        secret.write_text("not a log")
        (runtime / "shell.log").unlink()
        (runtime / "shell.log").symlink_to(secret)
        (xdg / "hypr/sig_1_2/hyprland.log").unlink()
        bundle = platform.retain_failure_diagnostics(runtime, xdg, cache, self.root / "failures", "compositor-ended-abnormally")
        self.assertEqual(set(json.loads((bundle / "manifest.json").read_text())["files"]), {"startup.log", "compositor.log"})

    def test_a_new_start_retires_only_its_profiles_last_runtime(self):
        xdg = self.root / "xdg"
        profile = self.root / "profiles" / "check"
        profile.mkdir(parents=True, mode=0o700)
        old = xdg / "enzui-shell-platform" / "check-0123456789abcdef"
        client = xdg / "e01234567"
        other = xdg / "enzui-shell-platform" / "other-fedcba9876543210"
        for directory in (old, client, other):
            directory.mkdir(parents=True, mode=0o700)
        (old / "startup.log").write_text("started")
        platform.publish(profile / "active.json", {"runtime": str(old)})
        platform.retire_previous(profile, xdg)
        self.assertFalse(old.exists())
        self.assertFalse(client.exists())
        self.assertTrue(other.exists())
        self.assertEqual((profile / "last-startup.log").read_text(), "started")
        outside = self.root / "elsewhere" / "check-0123456789abcdef"
        outside.mkdir(parents=True)
        platform.publish(profile / "active.json", {"runtime": str(outside)})
        platform.retire_previous(profile, xdg)
        self.assertTrue(outside.exists(), "only the runtime parent is touched")
        platform.publish(profile / "active.json", {"runtime": str(other)})
        platform.retire_previous(profile, xdg)
        self.assertTrue(other.exists(), "another profile's runtime is kept")

    def test_publish_is_private_bounded_and_lock_is_exclusive(self):
        path = self.root / "state.json"
        platform.publish(path, {"version": 1})
        self.assertEqual(json.loads(platform.read_private(path)), {"version": 1})
        self.assertEqual(path.stat().st_mode & 0o777, 0o600)
        with self.assertRaises(RuntimeError):
            platform.read_private(path, 1)
        with platform.private_file(self.root / "lock", create=True) as first:
            fcntl.flock(first, fcntl.LOCK_EX | fcntl.LOCK_NB)
            with platform.private_file(self.root / "lock", create=True) as second:
                with self.assertRaises(BlockingIOError):
                    fcntl.flock(second, fcntl.LOCK_EX | fcntl.LOCK_NB)

    def test_private_bus_requires_the_managed_peer_not_just_a_unix_address(self):
        path = self.root / "bus,owned"
        with socket.socket(socket.AF_UNIX) as server:
            server.bind(str(path))
            server.listen(4)
            address = "unix:path=" + quote(str(path), safe="/") + ",guid=fixture"
            with mock.patch.object(platform, "member", return_value=True) as member:
                identity = platform.private_bus(address, "owned.service")
                self.assertEqual(identity["pid"], os.getpid())
                member.assert_called_once_with(os.getpid(), "owned.service")
            with mock.patch.object(platform, "member", return_value=False):
                with self.assertRaises(RuntimeError):
                    platform.private_bus(address, "foreign.service")
        for address in ("tcp:host=localhost", "unix:path=/a;unix:path=/b", "unix:path=/a,abstract=b", "unix:path=/a,path=/b"):
            with self.assertRaises(RuntimeError):
                platform.private_bus(address, "owned.service")

    def test_inner_refuses_changed_launch_data_and_undelegated_execution(self):
        path=self.root/"launch.json";platform.publish(path,{"unit":"fixture.service"})
        with mock.patch.object(platform,"prepare_desktop") as prepare:
            with self.assertRaisesRegex(RuntimeError,"configuration changed"):
                platform.inner(str(path),"0"*64)
            with self.assertRaises(RuntimeError):
                platform.delegated_root("definitely-not-this-service.service")
            prepare.assert_not_called()

    def installed_wait(self, replies, stopping=None):
        clock = iter(range(0, 1000, 1))
        calls = []
        def query(argv, **kwargs):
            calls.append(argv)
            reply = replies.pop(0)
            if isinstance(reply, BaseException):
                raise reply
            return subprocess.CompletedProcess(argv, reply[0], reply[1], "")
        platform.wait_installed_unit("fixture.service", stopping if stopping is not None else [], query=query, clock=lambda: next(clock), sleep=lambda _: None)
        return calls

    def test_installed_wait_survives_a_user_manager_reexec(self):
        refused = (1, "")
        replies = [(0, "active\n"), refused, subprocess.TimeoutExpired("systemctl", 2), refused, (0, "reloading\n"), (0, "active\n"), (0, "inactive\n")]
        self.assertEqual(len(self.installed_wait(replies)), 7)

    def test_installed_wait_ends_on_failure_stop_or_lasting_outage(self):
        self.assertEqual(len(self.installed_wait([(0, "active\n"), (0, "failed\n")])), 2)
        self.assertEqual(self.installed_wait([], stopping=[True]), [])
        with self.assertRaisesRegex(RuntimeError, "User manager unavailable"):
            self.installed_wait([(1, "")] * 20)

    def test_a_preview_registers_its_own_portal_backend_only_when_built(self):
        with tempfile.TemporaryDirectory() as folder:
            runtime, binaries = Path(folder) / "runtime", Path(folder) / "bin"
            runtime.mkdir()
            binaries.mkdir()
            self.assertIsNone(platform.portal_registration(runtime, binaries))
            portal = binaries / "enzui-portal"
            portal.write_text("#!/bin/sh\n")
            portal.chmod(0o755)
            data = platform.portal_registration(runtime, binaries)
            self.assertEqual(data, runtime / "portal-data")
            service = (data / "dbus-1/services/org.freedesktop.impl.portal.desktop.enzui.service").read_text()
            self.assertIn(f"Exec={portal.resolve()}", service)
            self.assertIn("FileChooser", (data / "xdg-desktop-portal/portals/enzui.portal").read_text())
            self.assertIn("org.freedesktop.impl.portal.FileChooser=enzui;gtk;",
                          (data / "xdg-desktop-portal/enzui-portals.conf").read_text().splitlines())
            self.assertEqual(oct(data.stat().st_mode & 0o777), "0o700")
            bus = "org.freedesktop.impl.portal.desktop.enzuiremote"
            activation = Path(f"dbus-1/services/{bus}.service")
            self.assertFalse((data / activation).exists())
            remote = binaries / "xdg-desktop-portal-enzui-remote"
            remote.write_text("#!/bin/sh\n")
            remote.chmod(0o755)
            shutil.rmtree(data)
            data = platform.portal_registration(runtime, binaries)
            service = (data / activation).read_text()
            self.assertIn(f"Name={bus}\n", service)
            self.assertIn(f"Exec=/usr/bin/env XDPH_BUS_NAME={bus} {remote.resolve()}\n", service)
            self.assertIn(str(remote.resolve()), platform.privileged_clients(binaries)["ENZUI_PORTAL_EXES"].split(":"))
            descriptor = (data / "xdg-desktop-portal/portals/enzui-remote.portal").read_text()
            routes = (data / "xdg-desktop-portal/enzui-portals.conf").read_text()
            for interface in ("Screenshot", "ScreenCast", "RemoteDesktop", "GlobalShortcuts", "InputCapture"):
                self.assertIn(f"org.freedesktop.impl.portal.{interface};", descriptor)
                self.assertIn(f"org.freedesktop.impl.portal.{interface}=enzui-remote;", routes)

    def test_saved_displays_start_at_their_remembered_scale(self):
        settings = self.root / "saved-displays.json"
        settings.write_text(json.dumps({"displays": [
            {"enabled": True, "key": "Panasonic Industry Company|VVX14T092N00|0x89210600", "width": 2256, "height": 1504,
             "refresh_mhz": 60001, "rotation": "normal", "scale": 1.5, "x": 0, "y": 0},
            {"enabled": True, "key": "port:HDMI-A-1", "width": 1920, "height": 1080, "refresh_mhz": 60000,
             "rotation": "left", "scale": 1, "x": 1504, "y": 0},
            {"enabled": True, "key": "Bad\"|x\n|y", "width": 1920, "height": 1080, "refresh_mhz": 60000, "scale": 1, "x": 0, "y": 0},
            {"enabled": False, "key": "Off|Mon|1", "width": 1920, "height": 1080, "refresh_mhz": 60000, "scale": 1, "x": 0, "y": 0},
            {"enabled": True, "key": "A|B|C", "width": 1920, "height": 1080, "refresh_mhz": 60000, "scale": 9, "x": 0, "y": 0}]}))
        lua = platform.saved_displays_lua(settings).decode()
        self.assertIn('hl.monitor({ output = "desc:Panasonic Industry Company VVX14T092N00 0x89210600", mode = "2256x1504@60.001", position = "auto", scale = 1.5, transform = 0, reserved = { top = 36 } })', lua)
        self.assertIn('hl.monitor({ output = "HDMI-A-1", mode = "1920x1080@60", position = "auto", scale = 1.0, transform = 3, reserved = { top = 36 } })', lua)
        self.assertEqual(lua.count("hl.monitor("), 2)
        self.assertIn('enzui_saved_display_outputs = { ["desc:Panasonic Industry Company VVX14T092N00 0x89210600"] = true, ["HDMI-A-1"] = true }', lua)
        self.assertEqual(platform.saved_displays_lua(self.root / "missing.json"), b"")
        config = platform.runtime_config(platform.ROOT / "config/hyprland.lua", False, installed=True, settings=settings)
        self.assertIn(b"enzui_saved_display_outputs", config)
        self.assertNotIn(b"enzui_saved_display_outputs", platform.runtime_config(platform.ROOT / "config/hyprland.lua", False, installed=False, settings=settings))

    def test_privileged_clients_name_the_shell_and_only_explicit_dev_tools(self):
        values = platform.privileged_clients(self.root)
        self.assertEqual(values["ENZUI_PRIVILEGED_CLIENTS"], "enforce")
