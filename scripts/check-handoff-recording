#!/usr/bin/env python3
"""Compare every captured ROI frame with stable app/placeholder references."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

import numpy as np

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('video', type=Path)
parser.add_argument('--crop', required=True, help='WIDTH:HEIGHT:X:Y of a desktop region or dialog')
parser.add_argument('--protected-frame', required=True, type=int)
parser.add_argument('--returning-frame', type=int, help='Optional inspected Returning to desktop placeholder frame')
parser.add_argument('--before-frame', type=int, default=10)
parser.add_argument('--max-frames', type=int, default=1200)
parser.add_argument('--threshold', type=float, default=1.0)
args = parser.parse_args()
if not args.video.is_file():
    parser.error('video must be an existing local file')
args.video = args.video.resolve()
try:
    width, height, x, y = map(int, args.crop.split(':'))
except ValueError:
    parser.error('crop must contain four integers')
if not (1 <= width <= 8192 and 1 <= height <= 8192 and x >= 0 and y >= 0):
    parser.error('crop is out of bounds')
if not (1 <= args.max_frames <= 1200 and 0 <= args.threshold <= 255):
    parser.error('analysis bound is out of range')
probe = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'v:0',
                        '-show_entries', 'stream=width,height', '-of', 'json', str(args.video)],
                       capture_output=True, timeout=10)
if probe.returncode:
    raise SystemExit('Could not inspect recording dimensions')
streams = json.loads(probe.stdout).get('streams', [])
if not streams or x + width > streams[0]['width'] or y + height > streams[0]['height']:
    parser.error('crop must lie entirely inside the video frame')
scale = min(0.25, 256 / max(width, height))
out_width = max(1, int(width * scale))
out_height = max(1, int(height * scale))
command = ['ffmpeg', '-nostdin', '-v', 'error', '-threads', '1', '-filter_threads', '1', '-i', str(args.video),
           '-vf', f'crop={width}:{height}:{x}:{y},scale={out_width}:{out_height}',
           '-frames:v', str(args.max_frames + 1), '-threads', '1', '-pix_fmt', 'rgb24', '-f', 'rawvideo', '-']
result = subprocess.run(command, capture_output=True, timeout=60)
if result.returncode:
    raise SystemExit('Could not decode the recording: ' + result.stderr.decode(errors='replace')[:500])
frame_size = out_width * out_height * 3
if len(result.stdout) % frame_size:
    raise SystemExit('Recording ended with an incomplete frame')
frames = np.frombuffer(result.stdout, dtype=np.uint8).reshape(-1, out_height, out_width, 3)
if not 1 <= len(frames) <= args.max_frames:
    raise SystemExit('Recording is empty or exceeds the analysis frame bound')
indices = [args.before_frame, args.protected_frame]
if args.returning_frame is not None:
    indices.append(args.returning_frame)
indices.append(len(frames) - 1)
if not all(0 <= index < len(frames) for index in indices):
    parser.error('reference frame is outside the recording')
references = [frames[index].astype(np.int16) for index in indices]
distance = np.array([[np.abs(frame.astype(np.int16) - reference).mean()
                      for reference in references] for frame in frames])
error = distance.min(axis=1)
labels = distance.argmin(axis=1)
bad = np.flatnonzero(error > args.threshold)
print(json.dumps({
    'measurement': 'captured-frame appearance, not latency or proof that every displayed frame was sampled',
    'frames': len(frames), 'analysis_size': [out_width, out_height],
    'reference_frames': indices, 'threshold_mean_rgb_channel_error': args.threshold,
    'max_nearest_error': float(error.max()), 'mismatching_frames': bad.tolist(),
    'class_boundaries': (np.flatnonzero(labels[1:] != labels[:-1]) + 1).tolist(),
}, indent=2))
sys.exit(1 if len(bad) else 0)
