#!/usr/bin/env bash
# Builds enzwall in its own workspace, optionally staging the renderer beside enzui-wallpaper.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
"$root/enzwall/scripts/setup-sources"
"$root/scripts/with-build-budget" cargo build --offline --locked --release -j1 \
    --manifest-path "$root/enzwall/Cargo.toml" -p enzwall
binary="$root/enzwall/target/release/enzwall"
if (($#)); then
    target=$(realpath -- "$1")
    case "$target" in
        "$root"/*) ;;
        *) echo "build-enzwall: stage only into a directory inside this repository" >&2; exit 2 ;;
    esac
    install -m 0755 "$binary" "$target/enzwall"
    echo "staged $target/enzwall"
fi
