#!/usr/bin/env bash
# Translates pinned framework material WGSL to GLSL ES in OUT/material-shaders.h.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
out=${1:?usage: build-material-shaders OUT}
target=$(realpath -m -- "${ENZUI_WGSL_TARGET_DIR:-$root/.build/wgsl-glsl}")
# Inside an already capped build (the plugin builds), run under its budget.
budget=("$root/scripts/with-build-budget")
[[ ${ENZUI_BUILD_CAPPED:-0} == 1 ]] && budget=()
CARGO_TARGET_DIR="$target" "${budget[@]}" \
    cargo build --offline --locked --release --quiet --manifest-path "$root/tools/wgsl-glsl/Cargo.toml"
"$target/release/enzui-wgsl-glsl" "$root/vendor/iced/wgpu/src/shader" "$out/material-shaders.h"
