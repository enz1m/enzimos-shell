#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
if [[ ${ENZUI_BUILD_CAPPED:-0} != 1 ]]; then
    exec "$root/scripts/with-build-budget" "$0" "$@"
fi
mkdir -p "$root/.build/icon-drop-tests"
binary=$(mktemp "$root/.build/icon-drop-tests/check-XXXXXXXX")
trap 'rm -f "$binary"' EXIT
/usr/bin/c++ -std=c++20 -Wall -Wextra -Werror -O1 -g0 \
    "$root/tools/probes/test-icon-drop-lease.cpp" -o "$binary"
"$binary"
printf '%s\n' 'Icon drop lease: qualified press, released-only single use, distance, cancellation, expiry and finite positions passed.'
