#!/usr/bin/env bash
# Builds installed binaries under budget; --bin-dir stages without replacing running milestones.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
out=$root/.build/release/bin
if (($#)); then
    if (($# != 2)) || [[ $1 != --bin-dir ]]; then
        echo "usage: scripts/build-release [--bin-dir NEW_DIRECTORY]" >&2; exit 2
    fi
    out=$(realpath -m -- "$2")
    case "$out" in "$root/.build/"*) ;; *) echo "build-release: destination must be under .build/" >&2; exit 2 ;; esac
    if [[ -e $out ]] && [[ ! -d $out || -n $(find "$out" -mindepth 1 -print -quit) ]]; then
        echo "build-release: custom destination must be absent or empty" >&2; exit 2
    fi
fi
binaries=(enzui-shell enzui-settings enzui-welcome enzui-shell-command enzui-idle-inhibit enzui-desktop-frame enzui-maximize-preview enzui-wallpaper enzui-polkit-agent enzui-location-agent enzui-keyring-prompt enzui-drive-unlock enzui-agent-consent enzui-share-picker enzui-assistant enzui-network-secrets enzui-portal enzui-lock enzui-greeter enzui-dev-tools enzui-power-boost)
cargo_targets=()
for name in "${binaries[@]}"; do cargo_targets+=(--bin "$name"); done
"$root/scripts/setup-sources"
# What is compiled, taken before the build: see scripts/build-receipt.
source=$(python3 - "$root" <<'PY'
import hashlib, json, subprocess, sys
root = sys.argv[1]
def state(directory):
    return json.loads(subprocess.run([f"{root}/scripts/build-receipt", "source", directory], capture_output=True, text=True, check=True).stdout)
def digest(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()
print(json.dumps({"component": "shell", "source": state(root), "framework": state(f"{root}/vendor/enzui"),
                  "sources_lock_sha256": digest(f"{root}/sources.lock.json"), "cargo_lock_sha256": digest(f"{root}/Cargo.lock"),
                  "profile": "release"}))
PY
)
install -d "$out"
# Cargo output paths identify the worker binary paired with this shell build.
"$root/scripts/with-build-budget" cargo build --offline --locked --release --manifest-path "$root/Cargo.toml" -p enzui-shell -p enzui-lock -p enzui-power-boost "${cargo_targets[@]}" \
    --message-format=json-render-diagnostics > "$out/.cargo-messages.json"
worker=$(python3 -c '
import json, sys
dirs = [m["out_dir"] for m in map(json.loads, open(sys.argv[1])) if m.get("reason") == "build-script-executed" and "#enzui-shell@" in m["package_id"]]
if len(dirs) != 1:
    sys.exit("build-release: expected one enzui-shell build script output")
print(dirs[0] + "/enzui-plugin-worker")
' "$out/.cargo-messages.json")
rm -f "$out/.cargo-messages.json"
[ -f "$worker" ] || { echo "build-release: the plugin worker was not built (native Linux and libseccomp are required)" >&2; exit 1; }
install -m 0755 "$worker" "$out/.enzui-plugin-worker.new" && mv -f "$out/.enzui-plugin-worker.new" "$out/enzui-plugin-worker"
hasher=$(dirname -- "$worker")/enzui-password-hash
[ -f "$hasher" ] || { echo "build-release: the system password helper was not built" >&2; exit 1; }
install -m 0755 "$hasher" "$out/.enzui-password-hash.new" && mv -f "$out/.enzui-password-hash.new" "$out/enzui-password-hash"
"$root/scripts/build-enzwall"
for name in "${binaries[@]}"; do
    install -m 0755 "$root/target/release/$name" "$out/.$name.new" && mv -f "$out/.$name.new" "$out/$name"
done
install -m 0755 "$root/enzwall/target/release/enzwall" "$out/.enzwall.new" && mv -f "$out/.enzwall.new" "$out/enzwall"
# Embedded font subsets travel with their OFL notices and pinned provenance.
install -d "$out/font-licenses"
for font_license in "$root"/shell/assets/lock-fonts/*-OFL.txt; do
    install -m 0644 "$font_license" "$out/font-licenses/$(basename -- "$font_license")"
done
install -m 0644 "$root/shell/assets/lock-fonts/sources.json" "$out/font-licenses/sources.json"
"$root/scripts/build-window-snapshot" > /dev/null
install -m 0755 "$root/.build/window-snapshot/window-snapshot" "$out/.window-snapshot.new" && mv -f "$out/.window-snapshot.new" "$out/window-snapshot"
portal=$("$root/scripts/build-remote-desktop-portal")
install -m 0755 "$portal/xdg-desktop-portal-enzui-remote" "$out/.xdg-desktop-portal-enzui-remote.new" && mv -f "$out/.xdg-desktop-portal-enzui-remote.new" "$out/xdg-desktop-portal-enzui-remote"
install -m 0644 "$portal/remote-desktop-portal.json" "$out/remote-desktop-portal.json"
install -m 0644 "$portal/remote-desktop.patch" "$out/remote-desktop.patch"
install -m 0644 "$root/vendor/xdg-desktop-portal-hyprland/LICENSE" "$out/xdg-desktop-portal-hyprland-LICENSE"
git -C "$root" rev-parse HEAD > "$out/SOURCE_REVISION"
names=(enzui-plugin-worker enzui-password-hash "${binaries[@]}" enzwall window-snapshot xdg-desktop-portal-enzui-remote)
names+=(font-licenses/Fredoka-OFL.txt font-licenses/Nunito-OFL.txt font-licenses/Quicksand-OFL.txt font-licenses/Rubik-OFL.txt font-licenses/sources.json)
"$root/scripts/build-receipt" write "$out/BUILD_RECEIPT.json" "$source" "${names[@]/#/$out/}"
echo "Release executables in $out"
