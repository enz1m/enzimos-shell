    def test_profile_and_canvas_bounds(self):
        self.assertEqual(platform.profile_name("fixture-1"), "fixture-1")
        for value in ("../other", "Upper", "", "a" * 33, "a;exec"):
            with self.assertRaises(argparse.ArgumentTypeError):
                platform.profile_name(value)
        self.assertEqual(platform.dimensions("1440x900"), [1440, 900])
        for value in ("1x2", "0x900", "900x9000", "4096x4096", "900x800;", "1440X900"):
