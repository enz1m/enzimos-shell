    def test_startup_failure_retains_a_verified_compositor_until_it_exits(self):
        import hashlib
        project=self.root/"project";(project/"config").mkdir(parents=True);(project/"config/hyprland.lua").write_text("fixture")
        runtime=self.root/"runtime";runtime.mkdir(mode=0o700)
        config={"unit":"enzui-platform-fixture-0123456789abcdef.service","profile":str(self.root/"profile"),"runtime":str(runtime),"parent_socket":"/fixture","parent_peer":{"pid":1}}
        path=runtime/"launch.json";platform.publish(path,config);digest=hashlib.sha256(platform.read_private(path)).hexdigest()
        compositor,ticks=self.process();self.after(.2,compositor.kill)
        with mock.patch.object(platform,"ROOT",project),mock.patch.object(platform,"member",return_value=True),mock.patch.object(platform,"delegated_root"),mock.patch.object(platform,"peer",return_value={"pid":1}),mock.patch.object(platform,"private_bus",return_value={"pid":2}),mock.patch.object(platform,"prepare_desktop",side_effect=RuntimeError("fixture")),mock.patch.object(platform,"compositor",return_value={"pid":compositor.pid,"start":ticks}),mock.patch.object(platform,"command") as command,mock.patch.dict(os.environ,{"DBUS_SESSION_BUS_ADDRESS":"unix:path=/fixture"}):
            platform.inner(str(path),digest)
            command.assert_not_called()
        self.assertIsNotNone(compositor.poll())
        self.assertTrue((runtime/"failed.json").exists())
        self.assertFalse((runtime/"ready.json").exists())

    def test_installed_startup_failure_ends_the_login_with_its_reason(self):
        import hashlib
        project=self.root/"project";(project/"config").mkdir(parents=True);(project/"config/hyprland.lua").write_text("fixture")
        runtime=self.root/"runtime";runtime.mkdir(mode=0o700)
        config={"unit":"enzui-platform-desktop-0123456789abcdef.service","profile":str(self.root/"profile"),"runtime":str(runtime),"installed":True}
        path=runtime/"launch.json";platform.publish(path,config);digest=hashlib.sha256(platform.read_private(path)).hexdigest()
        failure=platform.incomplete_shell_startup(42,True,[{"pid":42,"class":"dev.enzui.Sidebar","title":"private"},{"pid":7,"class":"org.example.App"}])
        self.assertEqual(failure,"Shell startup is incomplete (shell executable verified; compositor clients 2; shell surfaces dev.enzui.Sidebar)")
        with mock.patch.object(platform,"ROOT",project),mock.patch.object(platform,"member",return_value=True),mock.patch.object(platform,"delegated_root"),mock.patch.object(platform,"session_bus",return_value=("unix:path=/fixture",{"pid":2})),mock.patch.object(platform,"prepare_desktop",side_effect=RuntimeError(failure)),mock.patch.object(platform,"compositor") as compositor:
            with self.assertRaisesRegex(RuntimeError,"shell surfaces dev.enzui.Sidebar"):
                platform.inner(str(path),digest)
            compositor.assert_not_called()
        self.assertEqual(json.loads((runtime/"failed.json").read_text())["error"],failure)
        self.assertFalse((Path(config["profile"]) / "active.json").exists())
        self.assertIsNone(platform.desktop_failure(runtime,self.root/"xdg",None,"compositor-exited",True))
        self.assertEqual(platform.desktop_failure(runtime,self.root/"xdg",None,None,False),"startup-failed")
        bundle=platform.retain_failure_diagnostics(runtime,self.root/"xdg",None,self.root/"failures","startup-failed")
        self.assertEqual(json.loads((bundle/"manifest.json").read_text())["startup_error"],failure)

    def test_headless_rule_precedes_creation_and_origin_follows_parent_removal(self):
        parent = {"name": "WAYLAND-1", "width": 1440, "height": 900, "scale": 1.25, "transform": 0, "x": 0, "y": 10}
        target = {"name": "OWNED", "width": 400, "height": 640, "scale": 1, "transform": 0, "x": 1168, "y": 10}
        replies = iter([[parent], [parent, target], [{**target, "x": 0, "y": 0}]])
        calls = []
        def control(config, identity, *args):
            calls.append(args)
            return json.dumps(next(replies)) if args == ("-j", "monitors") else "ok"
        with mock.patch.object(platform, "control", side_effect=control):
            saved = platform.prepare_headless({"output": "OWNED", "headless": [400, 640]}, {"pid": 42})
        self.assertEqual(saved["parent"], parent)
        self.assertEqual(saved["temporary"], target)
        self.assertEqual(saved["final"], {**target, "x": 0, "y": 0})
        self.assertEqual(saved["pid"], 42)
        self.assertIs(saved["sampled_stages_only"], True)
        self.assertEqual(calls[1][0], "eval")
        self.assertIn('position="1168x10"', calls[1][1])
        self.assertEqual(calls[2], ("output", "create", "headless", "OWNED"))
        self.assertEqual(calls[4], ("output", "remove", "WAYLAND-1"))
        self.assertEqual(calls[5][0], "eval")
        self.assertIn('position="0x0"', calls[5][1])

        # A private compositor can have a renderer without a parent output.
        # It must still create the requested phone canvas at the origin.
        replies = iter([[], [{**target, "x": 0, "y": 0}]])
        calls.clear()
        with mock.patch.object(platform, "control", side_effect=control):
            saved = platform.prepare_headless({"output": "OWNED", "headless": [400, 640]}, {"pid": 42})
        self.assertEqual(saved["final"], {"name": "OWNED", "width": 400, "height": 640})
        self.assertIs(saved["standalone"], True)
        self.assertEqual(calls[2], ("output", "create", "headless", "OWNED"))
        self.assertNotIn(("output", "remove", "WAYLAND-1"), calls)

    def test_headless_origin_waits_for_applied_geometry(self):
        parent = {"name": "WAYLAND-1", "width": 1440, "height": 900, "scale": 1, "transform": 0, "x": 0, "y": 0}
        target = {"name": "OWNED", "width": 400, "height": 640, "scale": 1, "transform": 0, "x": 1456, "y": 0}
        replies = iter([[parent], [parent, target], [target], [{**target, "x": 0}]])
        def control(config, identity, *args):
            return json.dumps(next(replies)) if args == ("-j", "monitors") else "ok"
        with mock.patch.object(platform, "control", side_effect=control), mock.patch.object(platform.time, "sleep") as sleep:
            platform.prepare_headless({"output": "OWNED", "headless": [400, 640]}, {})
            sleep.assert_called_once_with(.05)

    def test_invalid_initial_headless_geometry_has_no_mutation(self):
        parent = {"name": "WAYLAND-1", "width": 1440, "height": 900, "scale": 1, "transform": 0, "x": 0, "y": 0}
        for change in [{"x": float("nan")}, {"scale": 0}, {"scale": True}, {"transform": 1}, {"width": -1}, {"name": "OTHER"}]:
            with self.subTest(change=change), mock.patch.object(platform, "control", return_value=json.dumps([{**parent, **change}])) as control:
                with self.assertRaises(RuntimeError):
                    platform.prepare_headless({"output": "OWNED", "headless": [400, 640]}, {})
                self.assertEqual(control.call_count, 1)

    def test_headless_mismatch_retains_parent(self):
        parent = {"name": "WAYLAND-1", "width": 1440, "height": 900, "scale": 1, "transform": 0, "x": 0, "y": 0}
        calls = []
        def control(config, identity, *args):
            calls.append(args)
            return json.dumps([parent]) if args == ("-j", "monitors") else "ok"
        with mock.patch.object(platform, "control", side_effect=control):
            with self.assertRaisesRegex(RuntimeError, "Temporary headless"):
                platform.prepare_headless({"output": "OWNED", "headless": [400, 640]}, {})
        self.assertNotIn(("output", "remove", "WAYLAND-1"), calls)

    def test_headless_parent_drift_is_rejected_before_removal(self):
        parent = {"name": "WAYLAND-1", "width": 1440, "height": 900, "scale": 1, "transform": 0, "x": 0, "y": 0}
        target = {"name": "OWNED", "width": 400, "height": 640, "scale": 1, "transform": 0, "x": 1456, "y": 0}
        replies = iter([[parent], [{**parent, "width": 1920}, target]])
        calls = []
        def control(config, identity, *args):
            calls.append(args)
            return json.dumps(next(replies)) if args == ("-j", "monitors") else "ok"
        with mock.patch.object(platform, "control", side_effect=control):
            with self.assertRaises(RuntimeError):
                platform.prepare_headless({"output": "OWNED", "headless": [400, 640]}, {})
        self.assertNotIn(("output", "remove", "WAYLAND-1"), calls)

    def test_headless_origin_wait_has_a_deadline(self):
        parent = {"name": "WAYLAND-1", "width": 1440, "height": 900, "scale": 1, "transform": 0, "x": 0, "y": 0}
        target = {"name": "OWNED", "width": 400, "height": 640, "scale": 1, "transform": 0, "x": 1456, "y": 0}
        replies = iter([[parent], [parent, target], [target]])
        def control(config, identity, *args):
            return json.dumps(next(replies)) if args == ("-j", "monitors") else "ok"
        with mock.patch.object(platform, "control", side_effect=control), mock.patch.object(platform.time, "monotonic", side_effect=[0, 4]), mock.patch.object(platform.time, "sleep") as sleep:
            with self.assertRaisesRegex(RuntimeError, "requested geometry"):
                platform.prepare_headless({"output": "OWNED", "headless": [400, 640]}, {})
            sleep.assert_not_called()

    def test_frontend_help_does_not_touch_the_legacy_runtime(self):
        runtime=self.root/"runtime";runtime.mkdir(mode=0o700)
        result=subprocess.run([str(SCRIPT.parent.parent/"enzui-hypr"),"platform","--help"],env={**os.environ,"XDG_RUNTIME_DIR":str(runtime)},capture_output=True,timeout=3)
        self.assertEqual(result.returncode,0,result.stderr)
        self.assertIn(b"--experimental",result.stdout)
        self.assertEqual(list(runtime.iterdir()),[])

    def test_missing_opt_in_has_no_startup_side_effects(self):
        with mock.patch.object(platform, "private_directory") as mkdir:
            with self.assertRaises(RuntimeError):
                platform.start(argparse.Namespace(experimental=False))
            mkdir.assert_not_called()

    def test_existing_profile_is_not_replaced(self):
        runtime = self.root / "runtime"
        config = self.root / "config"
        runtime.mkdir(mode=0o700)
        profile = config / "enzui-shell/profiles/fixture"
        platform.private_directory(profile)
        with platform.private_file(profile / "session.lock", create=True) as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            with mock.patch.dict(os.environ, {"XDG_RUNTIME_DIR": str(runtime), "XDG_CONFIG_HOME": str(config)}, clear=True), mock.patch.object(platform, "command") as command:
                with self.assertRaisesRegex(RuntimeError, "already in use"):
                    platform.start(argparse.Namespace(experimental=True, profile="fixture"))
                command.assert_not_called()

    def test_new_unit_uses_clean_environment_and_never_a_stop_or_build_command(self):
        self.check_binary_directory(None)

    def test_alternate_shell_binaries_are_scoped_without_replacing_defaults(self):
        self.check_binary_directory(".build/qa-target/debug")

    def test_missing_required_helpers_abort_before_creating_a_desktop(self):
        for helper in ("enzui-desktop-frame", "enzui-maximize-preview", "enzui-wallpaper"):
            with self.subTest(helper=helper), tempfile.TemporaryDirectory() as directory:
                self.check_binary_directory(None, missing=helper, root=Path(directory))

    def test_frame_requires_four_owned_edge_surfaces_with_complete_geometry(self):
        binary = self.root / "enzui-desktop-frame"
        binary.symlink_to("/proc/self/exe")
        config = {"output": "WAYLAND-1", "unit": "fixture.service", "shell_bin_dir": str(self.root)}
        monitor = {"name": "WAYLAND-1", "width": 1440, "height": 900, "scale": 1}
        geometry = [(0, 0, 1440, 116), (0, 784, 1440, 116), (0, 0, 64, 900), (1376, 0, 64, 900)]
        strips = [dict(zip(("x", "y", "w", "h"), edges), namespace="enzui-display-frame", pid=os.getpid()) for edges in geometry]
        level = "2"
        def ready():
            def control(config, identity, *args):
                return json.dumps([monitor] if args == ("-j", "monitors") else {"WAYLAND-1": {"levels": {level: strips}}})
            with mock.patch.object(platform, "control", side_effect=control), mock.patch.object(platform, "member", return_value=True):
                return platform.frame_strips_ready(config, {}, "WAYLAND-1")
        self.assertTrue(ready())
        level = "3"
        self.assertFalse(ready())
        level = "2"
        for index in range(4):
            removed = strips.pop(index)
            self.assertFalse(ready())
            strips.insert(index, removed)
        strips[1]["y"] = 746
        self.assertFalse(ready())
        strips[1]["y"] = 784
        strips[3]["pid"] = -1
        self.assertFalse(ready())

    def test_visible_review_preserves_screenshot_destination_and_cleanup_choice(self):
        self.check_binary_directory(None, headless=False, exit_with_shell=True)

    def check_binary_directory(self, alternate, headless=True, exit_with_shell=False, missing=None, root=None):
        root = root if root is not None else self.root
        project = root / "project"
        build = root / "build"
        binaries = project / (alternate or "target/debug")
        default = project / "target/debug/enzui-shell"
        default.parent.mkdir(parents=True, exist_ok=True)
        default.write_bytes(b"default fixture")
        for item in (binaries / "enzui-shell", binaries / "enzui-settings", binaries / "enzui-shell-command", binaries / "enzui-desktop-frame", binaries / "enzui-maximize-preview", binaries / "enzui-wallpaper", build / "hyprland-current-build/Hyprland", build / "hyprland-current-build/hyprctl/hyprctl", build / "shell-plugins/enzui-pointer-events.so", build / "build-revisions"):
            if item.name == missing:
                continue
            item.parent.mkdir(parents=True, exist_ok=True)
            item.write_bytes(b"fixture")
            item.chmod(0o700)
        runtime = root / "runtime"
        runtime.mkdir(mode=0o700)
        parent = root / "parent"
        calls = []
        def command(arguments, **kwargs):
            calls.append(arguments)
            self.assertEqual(arguments[0], "systemd-run")
            launch = Path(arguments[-2])
            config = json.loads(platform.read_private(launch))
            self.assertEqual(config["shell_bin_dir"], str(binaries))
            self.assertEqual(config["exit_with_shell"], exit_with_shell)
            self.assertIn("XDG_STATE_HOME=" + str(Path(config["profile"]) / "client-state"), arguments)
            self.assertNotIn("XDG_STATE_HOME=/foreign/state", arguments)
            capture = "ENZUI_SCREENSHOT_DIR=" + str(Path(config["settings"]).parent / "screenshots")
            if headless:
                self.assertIn(capture, arguments)
            else:
                self.assertFalse(any(arg.startswith("ENZUI_SCREENSHOT_DIR=") for arg in arguments))
            private_runtime = Path(config["xdg_runtime"])
            self.assertNotEqual(private_runtime, runtime)
            self.assertEqual(private_runtime.parent, runtime)
            self.assertEqual(len(private_runtime.name), 9)
            self.assertEqual(private_runtime.stat().st_mode & 0o777, 0o700)
            platform.publish(launch.parent / "ready.json", {"pid": 123, "output": config["output"]})
            return ""
        with socket.socket(socket.AF_UNIX) as server:
            server.bind(str(parent))
            server.listen(4)
            env = {"HOME": str(root), "XDG_RUNTIME_DIR": str(runtime), "XDG_CONFIG_HOME": str(root / "config"), "WAYLAND_DISPLAY": str(parent), "DO_NOT_FORWARD": "fixture-value", "XDG_SESSION_ID": "graphical-fixture", "XDG_STATE_HOME": "/foreign/state", "DBUS_SESSION_BUS_ADDRESS": "unix:path=/not-the-nested-bus"}
            with mock.patch.dict(os.environ, env, clear=True), mock.patch.object(platform, "ROOT", project), mock.patch.object(platform, "command", side_effect=command), mock.patch.object(platform, "compositor", return_value={"pid": 123}):
                args = argparse.Namespace(experimental=True, profile="fixture", build_root=str(build), shell_bin_dir=str(binaries) if alternate else None, headless=[360, 640] if headless else None, memory_mib=1536, exit_with_shell=exit_with_shell)
                if missing:
                    with self.assertRaisesRegex(RuntimeError, "bundle is incomplete.*" + missing):
                        platform.start(args)
                else:
                    platform.start(args)
        if missing:
            self.assertEqual(calls, [])
            return
        self.assertEqual(len(calls), 1)
        args = calls[0]
        self.assertIn("KillMode=control-group", args)
        self.assertIn("TimeoutStopSec=10s", args)
        self.assertIn("SendSIGKILL=yes", args)
        self.assertIn("Restart=no", args)
        self.assertIn("Delegate=yes", args)
        self.assertIn("DelegateSubgroup=supervisor", args)
        self.assertIn("MemoryMax=1536M", args)
        self.assertIn("MemorySwapMax=0", args)
        self.assertIn("/usr/bin/dbus-run-session", args)
        self.assertIn("-i", args)
        self.assertIn("ENZUI_PLUGIN_ISOLATION=delegated", args)
        self.assertIn("XDG_SESSION_ID=graphical-fixture", args)
        self.assertIn("ENZUI_SHELL_BIN_DIR=" + str(binaries), args)
        if alternate:
            self.assertEqual(default.read_bytes(), b"default fixture")
        self.assertTrue(any(arg.startswith("WAYLAND_DISPLAY=") and arg.endswith("/wayland-unavailable") for arg in args))
        self.assertNotIn("WAYLAND_DISPLAY=" + str(parent), args)
        self.assertIn("ENZUI_HYPR_HOST_WAYLAND=" + str(parent), args)
        self.assertIn("GDK_BACKEND=wayland", args)
        self.assertIn("HYPRLAND_NO_SD_VARS=1", args)
        self.assertIn("PIPEWIRE_REMOTE=" + str(runtime / "pipewire-0"), args)
        self.assertFalse(any("DO_NOT_FORWARD" in arg or "/not-the-nested-bus" in arg for arg in args))
        self.assertNotIn("stop", args)
        self.assertNotIn("cargo", args)



if __name__ == "__main__":
    unittest.main()
