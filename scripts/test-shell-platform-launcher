        self.assertIn(b'hl.device({name="wl_keyboard",enabled=false})', isolated)
        self.assertIn(b'hl.device({name="wl_pointer",enabled=false})', isolated)
        self.assertEqual(source.read_bytes(), b"fixture\n")
        other = self.root / "other.lua"
        other.write_bytes(b"other")
        self.assertEqual(platform.runtime_config(other, True), b"other")

