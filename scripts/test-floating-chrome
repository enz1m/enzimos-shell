#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
if [[ ${ENZUI_BUILD_CAPPED:-0} != 1 ]]; then
    exec "$root/scripts/with-build-budget" "$0" "$@"
fi
mkdir -p "$root/.build/floating-chrome-tests"
binary=$(mktemp "$root/.build/floating-chrome-tests/check-XXXXXXXX")
trap 'rm -f "$binary"' EXIT
/usr/bin/c++ -std=c++20 -Wall -Wextra -Werror -O1 -g0 \
    "$root/tools/probes/test-floating-chrome.cpp" -o "$binary"
"$binary"
printf '%s\n' 'Floating chrome: bounded capsule regions match pixel-center hit tests.'
