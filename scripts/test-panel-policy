#!/usr/bin/env lua
local config = arg[0]:match("^(.*)/") .. "/../config/"
local path = config .. "panel-policy.lua"
local panel = {class="dev.enzui.Desktop",mapped=true,at={x=0,y=0},size={x=1440,y=36}}
local app = {class="app",mapped=true,at={x=200,y=80},size={x=800,y=600}}
local active, point = panel, {x=400,y=18}
local bindings, removed, dispatched, rules, panel_events = {}, {}, {}, {}, {}
local windows = {panel,app}
hl = {dsp={window={}}}
function hl.config() error("Panel policy must preserve compositor preferences") end
function hl.window_rule(value) rules[value.name]=value end
function hl.on(event,callback) panel_events[event]=callback end
function hl.get_active_window() return active end
function hl.get_cursor_pos() return point end
function hl.get_windows() return windows end
function hl.unbind(key) assert(key~="all");removed[key]=(removed[key]or 0)+1;bindings[key]=nil end
function hl.bind(key,action,options) bindings[key]={action=action,options=options} end
function hl.dispatch(action)
    if type(action)=="function" then return action() end
    table.insert(dispatched,action)
    return {ok=true,request_release=action.kind=="drag" or action.kind=="resize"}
end
for _,kind in ipairs({"close","float","fullscreen","move","drag","resize"}) do
    hl.dsp.window[kind]=function(args) return {kind=kind,args=args} end
end
local function call(key) return bindings[key].action() end
dofile(path)
local rule=rules["desktop-panel"]
assert(rule.match.class=="^dev[.]enzui[.]Desktop$" and rule.no_xdg_drags)
assert(rule.suppress_event=="maximize fullscreen")
local keyboard={"SUPER + Q","ALT + F4","SUPER + V","SUPER + F","SUPER + M"}
for i=1,9 do table.insert(keyboard,"SUPER + SHIFT + code:"..(i+9)) end
for _,key in ipairs(keyboard)do call(key) end
assert(#dispatched==0)
active=app
for _,key in ipairs(keyboard)do call(key) end
assert(#dispatched==#keyboard)
assert(dispatched[1].kind=="close" and dispatched[2].kind=="close")
local count=#dispatched
assert(call("SUPER + mouse:272").pass_event);assert(call("SUPER + mouse:273").pass_event);assert(#dispatched==count)
assert(bindings["SUPER + mouse:272"].options.mouse)
active=panel;point={x=400,y=200}
assert(call("SUPER + mouse:272").request_release)
local previous=bindings["SUPER + mouse:272"].action
dofile(path);assert(previous==bindings["SUPER + mouse:272"].action)
point={x=400,y=18};call("SUPER + mouse:272");assert(#dispatched==count+2)
call("SUPER + mouse:272");assert(#dispatched==count+2)
point={x=400,y=200};assert(call("SUPER + mouse:273").request_release)
point={x=400,y=18};call("SUPER + mouse:273");assert(#dispatched==count+4)
point={x=400,y=37};call("SUPER + mouse:272");assert(#dispatched==count+4)
panel.at={x=8,y=791};point={x=400,y=805};call("SUPER + mouse:272");assert(#dispatched==count+4)
panel.hidden=true;call("SUPER + mouse:272");assert(#dispatched==count+5);call("SUPER + mouse:272")
panel.hidden=false;panel.mapped=false;call("SUPER + mouse:273");assert(#dispatched==count+7);call("SUPER + mouse:273")
active=nil;call("SUPER + Q");assert(#dispatched==count+8)
panel.mapped=true;panel.class="dev.enzui.WorkspaceOverview";active=panel
call("SUPER + Q");assert(#dispatched==count+8)
for _,class in ipairs({"dev.enzui.PluginPanel","dev.enzui.NotificationCenter","dev.enzui.NotificationToasts"}) do
 panel.class=class
 for _,key in ipairs(keyboard)do call(key)end
 assert(#dispatched==count+8)
end
point={x=400,y=805};active=app
assert(call("SUPER + mouse:272").pass_event and call("SUPER + mouse:273").pass_event)
assert(#dispatched==count+8)
for _,n in pairs(removed)do assert(n==1) end
assert(removed["SUPER + Return"]==nil and removed["SUPER + 1"]==nil)
active=app;app.monitor={name="WAYLAND-1"}
function enzui_workspace_id_at(output,index)assert(output=="WAYLAND-1");if index==2 then return 23 end end
local count=#dispatched;call("SUPER + SHIFT + code:11");assert(#dispatched==count+1 and dispatched[#dispatched].args.workspace==23)
call("SUPER + SHIFT + code:18");assert(#dispatched==count+1)
local observed={}
function enzui_sidebar_press()observed[#observed+1]=#dispatched end
function enzui_sidebar_release()observed[#observed+1]=#dispatched end
panel.class="dev.enzui.Sidebar";panel.at={x=0,y=0};panel.size={x=36,y=864}
enzui_sidebar={entries={},reveal=false,error=""}
point={x=400,y=200};local start=#dispatched
call("SUPER + mouse:272")
enzui_sidebar.reveal=true;point={x=18,y=200};call("SUPER + mouse:272")
assert(observed[1]==start and observed[2]==start+2)
local before=#dispatched;assert(call("SUPER + mouse:272").pass_event);assert(#dispatched==before)
enzui_sidebar.reveal=false;call("SUPER + mouse:272");call("SUPER + mouse:272");assert(#dispatched==before+2)
print("Panel policy: client drags, focused shortcuts, pointer targeting, release-over-panel, sidebar hooks and hidden-rail passthrough passed.")

local primary, external = {name="WAYLAND-1"}, {name="EXTERNAL"}
local desktop, other_desktop, empty = {monitor=primary}, {monitor=external}, {monitor=primary}
local outputs = {[primary.name]=desktop, [external.name]=other_desktop}
local trigger = {class="dev.enzui.AssistantTrigger",mapped=true,monitor=primary,tags={}}
local external_panel = {class="dev.enzui.Desktop",mapped=true,monitor=external,tags={}}
panel.class="dev.enzui.Desktop";panel.monitor=primary;panel.tags={}
panel.pid=8
app.class="dev.enzui.Settings";app.pid=9;app.fullscreen=1;app.workspace=desktop;app.tags={}
local events={}
local refresh
function hl.timer(callback) assert(not refresh); refresh=callback; return {} end
local function settle()
    local callback=refresh
    refresh=nil
    callback()
end
function hl.dsp.event(value) return {kind="event", value=value} end
function hl.on(event,callback) events[event]=callback end
function hl.get_active_workspace(output) return outputs[output] end
function hl.get_windows() return {panel,trigger,external_panel,app} end
function hl.dsp.window.tag(args)
    return function()
        local marker=args.tag:sub(2)
        local tags=args.window.tags
        if args.tag:sub(1,1)=="+" then table.insert(tags,marker)
        else
            for i,tag in ipairs(tags) do if tag==marker then table.remove(tags,i);break end end
        end
        return {ok=true}
    end
end
local sidebar = {class="dev.enzui.AssistantPanel",mapped=true,monitor=primary,tags={}}
local remote_sidebar = {class="dev.enzui.AssistantPanel",mapped=true,monitor=external,tags={}}
local prompt = {class="dev.enzui.PortalAccess",mapped=true,monitor=primary}
local other_prompt = {class="dev.enzui.PortalAccess",mapped=true,monitor=primary}
function hl.get_windows() return {sidebar, remote_sidebar, prompt, other_prompt} end
panel_events["window.open"](prompt)
assert(sidebar.tags[1]==rules["desktop-assistant-consent"].match.tag and #remote_sidebar.tags==0)
panel_events["window.close"](prompt)
assert(#sidebar.tags==1)
prompt.mapped=false
panel_events["window.close"](other_prompt)
assert(#sidebar.tags==0 and #remote_sidebar.tags==0)
print("Assistant consent hides the sidebar on the dialog's output until the last dialog closes.")

function hl.get_windows() return {panel,trigger,external_panel,app} end
dofile(config .. "fullscreen-policy.lua")
assert(not enzui_fullscreen_chrome_hidden(panel) and #app.tags==0)
app.fullscreen=2;events["window.fullscreen"](app)
assert(enzui_fullscreen_chrome_hidden(panel) and enzui_fullscreen_chrome_hidden(trigger))
assert(enzui_desktop_fullscreen())
assert(not enzui_fullscreen_chrome_hidden(external_panel) and #app.tags==1)
outputs[primary.name]=empty;events["workspace.active"](empty)
assert(not enzui_fullscreen_chrome_hidden(panel))
assert(not enzui_desktop_fullscreen())
outputs[primary.name]=desktop;events["workspace.active"](desktop)
assert(enzui_fullscreen_chrome_hidden(panel))
app.workspace=other_desktop;app.monitor=external;events["workspace.move_to_monitor"](other_desktop,external)
assert(not enzui_fullscreen_chrome_hidden(panel) and enzui_fullscreen_chrome_hidden(external_panel))
events["window.close"](app)
assert(not enzui_fullscreen_chrome_hidden(external_panel) and #app.tags==0)
assert(not enzui_desktop_fullscreen())
app.pid=panel.pid;events["window.open"](app)
assert(#app.tags==0 and not enzui_desktop_fullscreen())
app.pid=9;app.tags={"enzui-sidebar-app"};events["window.open"](app)
assert(#app.tags==1 and not enzui_desktop_fullscreen())
app.tags={"enzremote-preview"};events["window.open"](app)
assert(#app.tags==1 and not enzui_desktop_fullscreen())
app.tags={};app.fullscreen=0;app.borderless_fullscreen=true;active=app
events["window.active"](app)
events["window.borderless_fullscreen"](app)
assert(enzui_fullscreen_focused() and not enzui_fullscreen_chrome_hidden(external_panel))
settle()
assert(enzui_fullscreen_chrome_hidden(external_panel) and enzui_fullscreen_covers(app))
assert(not enzui_fullscreen_chrome_hidden(panel) and dispatched[#dispatched].value=="enzui-dock-changed")
active=panel;events["window.active"](panel);settle()
assert(not enzui_fullscreen_covers(app) and not enzui_fullscreen_chrome_hidden(external_panel))
active=app;events["window.active"](app);settle()
app.borderless_fullscreen=false;events["window.borderless_fullscreen"](app);settle()
assert(not enzui_fullscreen_focused() and not enzui_fullscreen_chrome_hidden(external_panel))

app.fullscreen=2;active=panel;events["window.fullscreen"](app)
assert(enzui_fullscreen_chrome_hidden(external_panel))
assert(not enzui_fullscreen_focused())

print("Fullscreen chrome follows the active desktop on each output.")
