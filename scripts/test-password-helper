#!/usr/bin/env python3
"""Check the unprivileged password hash helper against system libcrypt."""
import argparse
import ctypes
from pathlib import Path
import subprocess
import unittest

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--helper", required=True, type=Path)
options = parser.parse_args()
helper = options.helper.resolve(strict=True)


def invoke(value, *arguments):
    return subprocess.run([str(helper), *arguments], input=value, capture_output=True,
                          env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"}, timeout=15)


class PasswordHelperTests(unittest.TestCase):
    def test_hashes_verify_with_the_system_library_and_use_fresh_salts(self):
        password = b"test-only-password-helper-fixture"
        first, second = invoke(password), invoke(password)
        self.assertEqual(first.returncode, 0)
        self.assertEqual(second.returncode, 0)
        self.assertNotEqual(first.stdout, second.stdout)
        self.assertNotIn(password, first.stdout)
        library = ctypes.CDLL("libcrypt.so.2")
        library.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
        library.crypt.restype = ctypes.c_char_p
        encoded = first.stdout.strip()
        self.assertEqual(library.crypt(password, encoded), encoded)
        self.assertNotEqual(library.crypt(b"test-only-wrong-password", encoded), encoded)

    def test_invalid_or_oversized_input_and_arguments_are_rejected_without_echo(self):
        for value, arguments in [(b"", []), (b"embedded\0nul", []), (b"x" * 512, []),
                                 (b"test-only-password", ["unexpected"])]:
            with self.subTest(length=len(value), arguments=arguments):
                result = invoke(value, *arguments)
                self.assertNotEqual(result.returncode, 0)
                self.assertEqual(result.stdout, b"")
                self.assertEqual(result.stderr, b"Password hashing unavailable.\n")


unittest.main(argv=["test-password-helper"])
